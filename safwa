#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

if [[ "${1:-}" == "setup" ]]; then
  python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else "Python 3.12 or newer is required.")'
  python3 -m venv .venv
  .venv/bin/python -m pip install --require-hashes --only-binary=:all: -r requirements.lock
  .venv/bin/python scripts/cms.py init
  printf '%s\n' 'Setup complete. Create an administrator with: ./safwa create-user yourname --role admin' 'Start the CMS with: ./safwa local'
  exit 0
fi

if [[ ! -x .venv/bin/python ]]; then
  printf '%s\n' 'Run ./safwa setup first.' >&2
  exit 1
fi
exec .venv/bin/python scripts/cms.py "$@"
